# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local a git.

# --- Firebase (cliente; los valores salen de Firebase Console > Configuración del proyecto) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor). Usa UNA de estas dos opciones ---
# Opción A: JSON completo de la cuenta de servicio, en una sola línea o en base64
FIREBASE_SERVICE_ACCOUNT=
# Opción B: variables separadas (la clave privada con \n escritos literalmente, entre comillas)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- IA (Gemini) ---
GEMINI_API_KEY=

# --- Permisos de administrador: correos separados por coma (deben estar verificados en Firebase) ---
ADMIN_EMAILS=venrique70@gmail.com

# --- Opcionales ---
RESEND_API_KEY=
EMAIL_FROM=
AFFILIATE_ADMIN_EMAIL=
